# Copy this file to .env and fill in the values. .env is git-ignored.

# --- Docker Postgres (docker-compose.yml) ---
POSTGRES_USER=sportsanalyzer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sportsanalyzer
POSTGRES_PORT=5433

# Must match the values above.
SPORTSANALYZER_DB_URL=postgresql+asyncpg://sportsanalyzer:change-me@localhost:5433/sportsanalyzer

# --- API-Football (api-sports.io, free plan) ---
API_FOOTBALL_API_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_ENABLED=true
API_FOOTBALL_REQUESTS_PER_MINUTE=10
API_FOOTBALL_REQUESTS_PER_DAY=100

# --- TheSportsDB (free test key is "123") ---
THESPORTSDB_API_KEY=123
THESPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v1/json

# --- football-data.org (free key from football-data.org/client/register) ---
FOOTBALL_DATA_API_KEY=

# --- The Odds API (optional, free credits) ---
ODDS_API_KEY=

# --- Stake (used by the browser helper in extension/) ---
STAKE_ACCESS_TOKEN=
STAKE_USER_AGENT=
STAKE_CURRENCY=inr
# Money limits, enforced by the app before any bet reaches Stake
STAKE_MAX_BET=1
STAKE_TEST_BUDGET=20
STAKE_MAX_BETS_PER_DAY=10
# Bets above this always wait for your click, even in Auto mode
STAKE_APPROVAL_ABOVE=1000
